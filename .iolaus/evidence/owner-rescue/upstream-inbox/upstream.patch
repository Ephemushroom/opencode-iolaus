--- /dev/null
+++ b/packages/core/test/plugin/session-inbox.test.ts
@@ -0,0 +1,59 @@
+import { expect, expectTypeOf } from "bun:test"
+import { Plugin } from "@opencode/core/plugin"
+import { PluginHost } from "@opencode/core/plugin/host"
+import { PluginPromise } from "@opencode/core/plugin/promise"
+import { Session } from "@opencode/core/session"
+import { Effect } from "effect"
+import { testEffect } from "../lib/effect"
+import { PluginTestLayer } from "./fixture"
+
+const it = testEffect(PluginTestLayer)
+
+it.live("Effect plugins can read pending inbox requirements without consuming them", () =>
+  Effect.gen(function* () {
+    const plugins = yield* Plugin.Service
+    const context = yield* PluginHost.make(plugins)
+    expectTypeOf<keyof typeof context.session.inbox>().toEqualTypeOf<"list">()
+    const created = yield* context.session.create({ title: "Pending requirements" })
+    expect(yield* context.session.inbox.list({ sessionID: created.id })).toEqual([])
+    const admitted = yield* context.session.synthetic({
+      sessionID: created.id,
+      text: "Keep this requirement",
+      delivery: "queue",
+      resume: false,
+    })
+    expect(yield* context.session.context({ sessionID: created.id })).toEqual([])
+    expect(yield* context.session.inbox.list({ sessionID: created.id })).toEqual([admitted])
+    expect(yield* context.session.inbox.list({ sessionID: created.id })).toEqual([admitted])
+    expect(Object.keys(context.session.inbox)).toEqual(["list"])
+    expect(yield* context.session.inbox.list({ sessionID: Session.ID.create() }).pipe(Effect.flip)).toMatchObject({
+      _tag: "Session.NotFoundError",
+    })
+  }),
+)
+
+it.live("Promise plugins can read pending inbox requirements without consuming them", () =>
+  Effect.gen(function* () {
+    const plugins = yield* Plugin.Service
+    const context = yield* PluginHost.make(plugins)
+    const created = yield* context.session.create({ title: "Promise pending requirements" })
+    yield* PluginPromise.fromPromise({
+      id: "test.session-inbox",
+      async setup(ctx) {
+        expectTypeOf<keyof typeof ctx.session.inbox>().toEqualTypeOf<"list">()
+        expect(await ctx.session.inbox.list({ sessionID: created.id })).toEqual([])
+        const admitted = await ctx.session.synthetic({
+          sessionID: created.id,
+          text: "Keep this requirement",
+          delivery: "queue",
+          resume: false,
+        })
+        expect(await ctx.session.context({ sessionID: created.id })).toEqual([])
+        expect(await ctx.session.inbox.list({ sessionID: created.id })).toEqual([admitted])
+        expect(await ctx.session.inbox.list({ sessionID: created.id })).toEqual([admitted])
+        expect(Object.keys(ctx.session.inbox)).toEqual(["list"])
+        await expect(ctx.session.inbox.list({ sessionID: Session.ID.create() })).rejects.toThrow()
+      },
+    }).effect(context)
+  }),
+)
